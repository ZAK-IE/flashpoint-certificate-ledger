# Connection string from the Neon dashboard. Keep sslmode=require on it.
DATABASE_URL=postgresql://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Write keys, one per training institute. Change these before showing anyone.
# They are the only thing standing between the public and your ledger.
KEY_ATLANTIC=demo-atlantic-key
KEY_FUNDY=demo-fundy-key
KEY_BOWVALLEY=demo-bowvalley-key

# Set to false once the schema exists if you would rather run migrations by hand.
RUN_MIGRATIONS=true

# Render supplies PORT itself. Only needed when running on your own machine.
PORT=3000
